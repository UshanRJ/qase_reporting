# Streamlit Secrets Template
# 
# IMPORTANT: This is a TEMPLATE file for documentation purposes
# 
# For LOCAL development:
#   1. Copy this file to: .streamlit/secrets.toml
#   2. Replace values with your actual credentials
#   3. The secrets.toml file is gitignored and won't be committed
#
# For STREAMLIT CLOUD deployment:
#   1. DO NOT add this to repository
#   2. Add secrets in Streamlit Cloud dashboard:
#      - Go to your app settings
#      - Click "Secrets"
#      - Paste the TOML content below
#      - Replace with your actual values

# Qase API Configuration (REQUIRED)
QASE_API_TOKEN = "your_qase_api_token_here"
QASE_PROJECT_CODE = "ISP"

# Optional Configuration
EXPORT_DIR = "exports"
API_TIMEOUT = "300"
MAX_RESULTS = "1000"
CURRENT_SPRINT_NAME = "Sprint 24"
TEAM_PRODUCTIVITY_DAYS = "30"
PASS_RATE_TREND_MONTHS = "6"
OUTPUT_FORMAT = "both"
PASS_RATE_TARGET = "90.0"
EXECUTION_RATE_TARGET = "80.0"

# Optional: Simple Password Protection
# Uncomment the line below and set a password if you want to add basic auth
# APP_PASSWORD = "your_secure_password_here"

# Optional: Multi-User Authentication
# Uncomment and configure if you want user-based auth
# [users]
# admin = "admin_password"
# user1 = "user1_password"
# user2 = "user2_password"
